<UserControl x:Class="AYGUCI.Views.HeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="65">
	<Border Background="{StaticResource PanelBG}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
		<Grid Margin="20,0">
			<Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2" Width="200">
				<Path Data="M12,2L4.5,20.29L5.21,21L12,18L18.79,21L19.5,20.29L12,2Z" Fill="{StaticResource AccentBlue}" Width="26" Height="26" Stretch="Uniform"/>
				<StackPanel Margin="12,0,0,0">
					<TextBlock Text="AYGUCI" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="Bold"/>
					<TextBlock Text="GCS COMMAND CENTER" Foreground="{StaticResource TextDim}" FontSize="9"/>
				</StackPanel>
			</StackPanel>

            <UniformGrid Grid.Column="1" Rows="1" VerticalAlignment="Center" Margin="10,0">

                <Border Background="{StaticResource PanelBG}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Margin="5,0" Padding="0,5">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,3">
                            <TextBlock Text="&#xE709;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Total SIHA" Foreground="{StaticResource TextDim}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="12" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBG}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Margin="5,0" Padding="0,5">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,3">
                            <TextBlock Text="&#xE709;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource SuccessGreen}" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Aktif SIHA" Foreground="{StaticResource TextDim}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="8" Foreground="{StaticResource SuccessGreen}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBG}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Margin="5,0" Padding="0,5">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,3">
                            <TextBlock Text="&#xE1D1;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentBlue}" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Görevde" Foreground="{StaticResource TextDim}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="6" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBG}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Margin="5,0" Padding="0,5">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,3">
                            <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" Foreground="Gray" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Beklemede" Foreground="{StaticResource TextDim}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="2" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="#2A1111" BorderBrush="{StaticResource CriticalRed}" BorderThickness="1" CornerRadius="4" Margin="5,0" Padding="0,5">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,3">
                            <TextBlock Text="&#xEA3A;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource CriticalRed}" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ALERT" Foreground="{StaticResource CriticalRed}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="1" Foreground="{StaticResource CriticalRed}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBG}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Margin="5,0" Padding="0,5">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,3">
                            <TextBlock Text="&#xE12B;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Bağlantı" Foreground="{StaticResource TextDim}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="İYİ" Foreground="{StaticResource SuccessGreen}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <StackPanel Grid.Column="2" VerticalAlignment="Center">
				<TextBlock Text="14:32:18" Foreground="{StaticResource TextMain}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right"/>
				<TextBlock Text="21.04.2026" Foreground="{StaticResource TextDim}" FontSize="10" HorizontalAlignment="Right"/>
			</StackPanel>

            <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0" Orientation="Horizontal">

                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextDim}" FontSize="18" HorizontalAlignment="Left"/>
                    <TextBlock Text="OPERATÖR" Foreground="{StaticResource TextDim}" FontSize="12" Margin="2,0,0,2" HorizontalAlignment="Right"/>
            </StackPanel>


            <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Button Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" 
                               Foreground="{StaticResource TextDim}" FontSize="18" 
                               VerticalAlignment="Center" Margin="0,0,5,0"/>

                        <TextBlock Text="Ayarlar" Foreground="{StaticResource TextDim}" 
                               FontSize="14" FontWeight="SemiBold" 
                               VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
	</Border>
</UserControl>