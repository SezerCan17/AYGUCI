<UserControl x:Class="AYGUCI.Views.Selected_IHA_View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F141E">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Margin="5" Padding="10">
            <StackPanel>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="DRONE-01 ALPHA" Foreground="{StaticResource TextMain}" FontSize="18" FontWeight="Bold"/>
                        <Border Background="#1A10B981" BorderBrush="{StaticResource SuccessGreen}" BorderThickness="1" CornerRadius="4" 
                                HorizontalAlignment="Left" Padding="6,2" Margin="0,5,0,0">
                            <TextBlock Text="OTONOM (WAYPOINT)" Foreground="{StaticResource SuccessGreen}" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" MinWidth="120">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,5">
                            <TextBlock Text="PİL:" Foreground="{StaticResource TextDim}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ProgressBar Value="92" Maximum="100" Width="60" Height="8" Foreground="{StaticResource SuccessGreen}" Background="{StaticResource BorderColor}" BorderThickness="0"/>
                            <TextBlock Text="%92" Foreground="{StaticResource SuccessGreen}" FontSize="12" FontWeight="Bold" Margin="5,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="SİNYAL: İYİ (-65 dBm)" Foreground="{StaticResource TextDim}" FontSize="11"/>
                            <TextBlock Text=" | 45ms" Foreground="{StaticResource TextDim}" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Line X1="0" Y1="0" X2="400" Y2="0" Stroke="{StaticResource BorderColor}" StrokeThickness="1" Margin="0,0,0,15" Stretch="Fill"/>

                <TextBlock Text="KRİTİK UÇUŞ VERİLERİ" Foreground="{StaticResource AccentBlue}" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="2" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="HIZ" Foreground="{StaticResource TextDim}" FontSize="11"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="113" Foreground="{StaticResource TextMain}" FontSize="28" FontWeight="Bold"/>
                                <TextBlock Text="km/h" Foreground="{StaticResource TextDim}" FontSize="14" Margin="3,0,0,4" VerticalAlignment="Bottom"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="İRTİFA (MSL)" Foreground="{StaticResource TextDim}" FontSize="11"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="245" Foreground="{StaticResource TextMain}" FontSize="28" FontWeight="Bold"/>
                                <TextBlock Text="m" Foreground="{StaticResource TextDim}" FontSize="14" Margin="3,0,0,4" VerticalAlignment="Bottom"/>
                            </StackPanel>
                        </StackPanel>
                    </UniformGrid>

                    <Border Grid.Row="1" Background="{StaticResource PanelBG}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Koor:" Foreground="{StaticResource TextDim}" FontSize="12" Width="40"/>
                                <TextBlock Text="39° 55' 31&quot; N, 32° 51' 58&quot; E" Foreground="{StaticResource TextMain}" FontSize="12" FontWeight="SemiBold" FontFamily="Consolas"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Orientation="Horizontal">
                                <TextBlock Text="Yön:" Foreground="{StaticResource TextDim}" FontSize="12" Width="40"/>
                                <TextBlock Text="198°" Foreground="{StaticResource TextMain}" FontSize="12" FontWeight="SemiBold" Width="40"/>
                                <TextBlock Text="P: -12° | R: +5°" Foreground="{StaticResource TextMain}" FontSize="12" FontWeight="SemiBold" Margin="20,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <TextBlock Text="ÇEVRE &amp; SENSÖR" Foreground="{StaticResource AccentBlue}" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
                <Border Background="{StaticResource PanelBG}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Rüzgar:" Foreground="{StaticResource TextDim}" FontSize="11"/>
                            <TextBlock Text="12 km/h - KD" Foreground="{StaticResource TextMain}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="OAT (Sıcaklık):" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,5,0,0"/>
                            <TextBlock Text="-5°C" Foreground="{StaticResource TextMain}" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Gimbal Yönelim:" Foreground="{StaticResource TextDim}" FontSize="11"/>
                            <TextBlock Text="P: -45° | R: +15°" Foreground="{StaticResource TextMain}" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="FAYDALI YÜK" Foreground="{StaticResource AccentBlue}" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
                <Border Background="{StaticResource PanelBG}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="MAM-L:" Foreground="{StaticResource TextDim}" FontSize="12" Width="60"/>
                                <TextBlock Text="2 / 4" Foreground="{StaticResource TextMain}" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="MAM-C:" Foreground="{StaticResource TextDim}" FontSize="12" Width="60"/>
                                <TextBlock Text="4 / 4" Foreground="{StaticResource TextMain}" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1" Background="#1A10B981" BorderBrush="{StaticResource SuccessGreen}" BorderThickness="1" CornerRadius="4" Padding="10,0" VerticalAlignment="Center" Height="30">
                            <TextBlock Text="HEDEF KİLİTLENDİ" Foreground="{StaticResource SuccessGreen}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <TextBlock Text="KONTROL" Foreground="{StaticResource AccentBlue}" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>

                <UniformGrid Columns="2" Margin="0,0,0,10">
                    <Button Content="OTONOM: AÇIK" Background="{StaticResource BorderColor}" Foreground="{StaticResource TextMain}" BorderThickness="0" Height="35" Margin="0,0,5,0" FontWeight="SemiBold"/>
                    <Button Content="MANUEL KONTROL AL" Background="{StaticResource BorderColor}" Foreground="{StaticResource TextMain}" BorderThickness="0" Height="35" Margin="5,0,0,0" FontWeight="SemiBold"/>
                </UniformGrid>

                <UniformGrid Columns="2">
                    <Button Content="ACİL EVE DÖN (RTL)" Background="#1AEE4444" Foreground="{StaticResource CriticalRed}" BorderBrush="{StaticResource CriticalRed}" BorderThickness="1" Height="40" Margin="0,0,5,0" FontWeight="Bold"/>
                    <Button Content="GÖREVİ İPTAL ET" Background="#1AEE4444" Foreground="{StaticResource CriticalRed}" BorderBrush="{StaticResource CriticalRed}" BorderThickness="1" Height="40" Margin="5,0,0,0" FontWeight="Bold"/>
                </UniformGrid>

            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>