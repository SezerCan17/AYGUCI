<Window x:Class="AYGUCI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AYGUCI.Views"
        Title="AYGUCI GCS" WindowState="Maximized"
        Background="{StaticResource PrimaryBG}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <views:HeaderView Grid.Row="0"/>

        <Grid Grid.Row="1" Margin="20,20,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <views:IHAListView Grid.Column="0" />

            <views:MapView Grid.Column="2" />

            <!--<Border Grid.Column="2" Background="{StaticResource PanelBG}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4">
                <TextBlock Text="&#xE809; CANLI HARİTA MODÜLÜ" FontFamily="Segoe UI" FontSize="20" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.3"/>
            </Border>-->

            <Border Grid.Column="4" Background="{StaticResource PanelBG}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4">
                <TextBlock Text="SEÇİLİ İHA BİLGİLERİ" Foreground="{StaticResource TextDim}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.3"/>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

       
            <Border Grid.Column="0" Background="{StaticResource PanelBG}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4">
                <TextBlock Text="GÖREV ile ilgili Herşey" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.3"/>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBG}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4">
                <TextBlock Text="Bildirimler" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.3"/>
            </Border>
        </Grid>

    </Grid>
</Window>