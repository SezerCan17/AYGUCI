<Window x:Class="AYGUCI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AYGUCI.Views"
        Title="AYGUCI GCS" WindowState="Maximized"
        Background="{StaticResource PrimaryBG}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <views:HeaderView Grid.Row="0"/>

        <Grid Grid.Row="1">
            <TextBlock Text="SİSTEM HAZIR" Foreground="{StaticResource TextDim}" 
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24"/>
        </Grid>
    </Grid>
</Window>